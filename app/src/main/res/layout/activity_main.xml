<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COPILOTO 99 POA"
            android:textColor="@color/accent_amber"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Janela Flutuante Automática • Rota SL ↔ POA • Meta R$ 480–550"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Card Permissões -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_metric_box"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. ATIVAÇÃO DO MONITOR FLUTUANTE"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sobreposição de Tela: Verificando..."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnPermOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#334155"
                android:text="Autorizar Janela Flutuante"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvStatusAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Leitura Automática (Acessibilidade): Verificando..."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnPermAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#334155"
                android:text="Ativar Leitura da Tela 99"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnStartService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/green_accept"
                android:text="INICIAR COPILOTO EM SEGUNDO PLANO"
                android:textColor="#0F172A"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTestOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/accent_amber"
                android:text="TESTAR JANELA FLUTUANTE AGORA"
                android:textColor="#0F172A"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Card Parâmetros -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_metric_box"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. FILTROS DO PLANO TURBO"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/swAutoSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:checked="true"
                android:text="Ajustar R$/km automático por horário (05:30–19:00)"
                android:textColor="@color/text_primary" />

            <Switch
                android:id="@+id/swBlockZonaSul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="Trava pós-15h: Bloquear Zona Sul e Extremos"
                android:textColor="@color/text_primary" />

            <Switch
                android:id="@+id/swBlockCashNight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="Trava Dinheiro: Apenas 07:00 às 17:30 (Nota 4,85+)"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Mínimo Fixo por KM (quando horário automático desligado):"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etMinKm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card_dark"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:text="2.30"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Mínimo por Minuto (R$/min — evita trânsito parado):"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etMinMinute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card_dark"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:text="0.75"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Distância Máxima até o Passageiro (km):"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etMaxPickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card_dark"
                android:inputType="numberDecimal"
                android:padding="10dp"
                android:text="1.5"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#38BDF8"
                android:text="Salvar Configurações"
                android:textColor="#0F172A"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
